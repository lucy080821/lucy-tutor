generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String?
  phone        String?
  avatar       String?
  role         String   @default("STUDENT") // "STUDENT" or "TEACHER"
  targetScore  Float    @default(7.0)
  currentLevel String   @default("Lost Roots")
  streakCount  Int      @default(0)
  lastActive   DateTime @default(now())
  totalXP      Int      @default(0)

  examResults ExamResult[]
  cheatLogs   CheatLog[]
  mistakeBank MistakeBank[]
  notebooks   MistakeNotebook[]

  classroomsOwned  Classroom[] @relation("TeacherClassrooms")
  classroomsJoined Classroom[] @relation("StudentClassrooms")
  uploadedExams    Exam[]      @relation("TeacherExams")
  assignedExams    Exam[]      @relation("AssignedExams")

  // Free-standing students (no classroom): assigned at signup, drives the trial/monthly-lock cycle.
  // Null for classroom students, teachers, and accounts created before the trial feature's cutoff date.
  accessExpiresAt DateTime?

  managerTeacherId String?
  managerTeacher   User?   @relation("ManagedFreeStudents", fields: [managerTeacherId], references: [id], onDelete: SetNull)
  managedFreeStudents User[] @relation("ManagedFreeStudents")

  freeStudentPaymentsMade      FreeStudentPayment[] @relation("FreeStudentPaymentStudent")
  freeStudentPaymentsConfirmed FreeStudentPayment[] @relation("FreeStudentPaymentTeacher")

  uploadedLessons   Lesson[]         @relation("TeacherLessons")
  lessonProgress    LessonProgress[]
  uploadedDocuments Document[]       @relation("TeacherDocuments")

  attendances     Attendance[]
  tuitionPayments TuitionPayment[]
  vocabProgress   UserVocabProgress[]

  uploadedListeningClips ListeningClip[] @relation("TeacherListeningClips")
  assignedListeningClips ListeningClip[] @relation("StudentListeningClips")

  uploadedSpeakingTopics SpeakingTopic[]   @relation("TeacherSpeakingTopics")
  assignedSpeakingTopics SpeakingTopic[]   @relation("StudentSpeakingTopics")
  speakingSessions       SpeakingSession[]

  skillPracticeResults SkillPracticeResult[]

  writingSubmissions    WritingSubmission[]
  savedWritingPrompts   SavedWritingPrompt[]
  readingAttempts       ReadingAttempt[]
  listeningExamAttempts ListeningExamAttempt[]

  selfAddedVocab        VocabItem[]            @relation("SelfAddedVocab")
  pronunciationAttempts PronunciationAttempt[]
  mockTestAttempts      MockTestAttempt[]

  uploadedIeltsBooks     IeltsBook[]
  ieltsLibraryTests      IeltsTest[]             @relation("IeltsTestLibraryStudent")
  ieltsAssignedTests     IeltsTest[]             @relation("IeltsTestAssignedStudents")
  ieltsListeningAttempts IeltsListeningAttempt[]
  ieltsReadingAttempts   IeltsReadingAttempt[]
  ieltsWritingAttempts   IeltsWritingAttempt[]
  ieltsSpeakingAttempts  IeltsSpeakingAttempt[]
  ieltsStudySessions     IeltsStudySession[]

  blogPosts         BlogPost[]         @relation("BlogPostAuthor")
  blogRevisions     BlogPostRevision[] @relation("BlogRevisionEditor")
  // Hồ sơ tác giả blog (/blog/tac-gia/[authorSlug]) — tự gán slug khi giáo viên đứng tên bài đầu tiên
  authorSlug  String? @unique
  authorTitle String? // Chức danh tự khai, vd "Giáo viên IELTS"
  authorBio   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id            String  @id @default(uuid())
  heading       String?
  content       String
  type          String
  difficulty    String
  options       String // stored as JSON string
  correctOption String
  explanation   String?
  imageUrl      String?
  points        Float   @default(1.0)

  mistakeBank MistakeBank[]
  exams       ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id             String @id @default(uuid())
  title          String
  duration       Int // in minutes
  totalQuestions Int

  examType    String    @default("REGULAR") // "REGULAR" or "PLACEMENT"
  grade       Int? // e.g., 6, 7, 8, 9, 10, 11, 12
  publishTime DateTime?
  deadline    DateTime?
  notes       String?
  maxAttempts Int       @default(1)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?   @relation("TeacherExams", fields: [uploadedById], references: [id], onDelete: SetNull)

  assignedStudents User[] @relation("AssignedExams")

  questions ExamQuestion[]
  results   ExamResult[]
  cheatLogs CheatLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamQuestion {
  examId     String
  questionId String
  order      Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
}

model ExamResult {
  id              String  @id @default(uuid())
  userId          String
  examId          String
  selectedAnswers String // stored as JSON string
  score           Float
  timeSpent       Int // in seconds
  gradingDetails  String? // stored as JSON string (AI feedback)
  cheatLogs       String? // stored as JSON string (Array of objects containing cheat details like {time: number})

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model CheatLog {
  id              String   @id @default(uuid())
  userId          String
  examId          String
  cheatCount      Int      @default(1)
  isAutoSubmitted Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
}

model MistakeBank {
  userId           String
  questionId       String
  wrongAnswerCount Int      @default(1)
  nextReviewDate   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

model MistakeNotebook {
  id            String @id @default(uuid())
  userId        String
  topic         String // e.g., "Câu điều kiện (Conditional Sentences)"
  category      String @default("GRAMMAR") // "GRAMMAR", "VOCABULARY", or "READING"
  theoryContent String // Comprehensive explanation generated by AI
  mistakeCount  Int    @default(1)
  correctCount  Int    @default(0)
  status        String @default("NEEDS_WORK") // "NEEDS_WORK" or "RESOLVED"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic])
}

model Classroom {
  id        String @id @default(uuid())
  name      String
  joinCode  String @unique
  teacherId String

  scheduleDays    String? // e.g. "1,3,5" for Mon, Wed, Fri (0 = Sunday)
  startTime       String? // e.g. "18:00"
  endTime         String? // e.g. "20:00"
  feeType         String  @default("PER_LESSON") // "PER_LESSON" | "MONTHLY" — chosen by teacher at class creation
  feePerLesson    Int     @default(0) // used when feeType = PER_LESSON
  feePerMonth     Int     @default(0) // used when feeType = MONTHLY — flat fee, independent of session count
  enabledFeatures String  @default("[]") // JSON array; empty = all features enabled

  teacher         User             @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  students        User[]           @relation("StudentClassrooms")
  exams           Exam[]
  classSessions   ClassSession[]
  lessons         Lesson[]
  attendances     Attendance[]
  tuitionPayments TuitionPayment[]
  documents       Document[]
  listeningClips  ListeningClip[]
  speakingTopics  SpeakingTopic[]

  ieltsLibraryTests  IeltsTest[] @relation("IeltsTestLibraryClassroom")
  ieltsAssignedTests IeltsTest[] @relation("IeltsTestAssignedClassroom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSession {
  id             String   @id @default(uuid())
  classroomId    String
  title          String?
  startTime      DateTime
  endTime        DateTime
  recurrenceRule String?
  location       String?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String  @id @default(uuid())
  title       String
  description String?

  uploadedById String?
  uploadedBy   User?   @relation("TeacherLessons", fields: [uploadedById], references: [id], onDelete: SetNull)

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  publishTime DateTime?
  deadline    DateTime?

  vocabularies VocabItem[]
  grammars     GrammarItem[]
  progress     LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VocabItem {
  id       String  @id @default(uuid())
  lessonId String? // null when self-added by a student directly (see addedByUserId), not tied to any teacher Lesson
  word     String
  pos      String?
  phonetic String?
  meaning  String
  example  String?
  imageUrl String?

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  addedByUserId String?
  addedBy       User?   @relation("SelfAddedVocab", fields: [addedByUserId], references: [id], onDelete: Cascade)

  progress UserVocabProgress[]
}

model GrammarItem {
  id          String  @id @default(uuid())
  lessonId    String
  title       String
  structure   String?
  explanation String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id       String @id @default(uuid())
  userId   String
  lessonId String
  status   String @default("UNREAD") // "UNREAD", "IN_PROGRESS", "COMPLETED"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Attendance {
  id          String   @id @default(uuid())
  classroomId String
  userId      String
  date        DateTime
  status      String // "PRESENT", "EXCUSED", "UNEXCUSED"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId, date])
}

model TuitionPayment {
  id          String    @id @default(uuid())
  classroomId String
  userId      String
  month       Int
  year        Int
  totalAmount Int
  status      String    @default("PAID") // "PAID", "UNPAID"
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId, month, year])
}

// One row per monthly renewal a teacher confirms for a free-standing (classless) student.
// Mirrors TuitionPayment's confirm-payment shape but has no classroom scope and no fixed
// fee — the teacher types the amount in each time (see freeStudent.routes.js).
model FreeStudentPayment {
  id        String   @id @default(uuid())
  userId    String
  teacherId String
  amount    Int
  paidAt    DateTime @default(now())
  periodEnd DateTime // access renewed until this date (paidAt + 1 calendar month)
  createdAt DateTime @default(now())

  user    User @relation("FreeStudentPaymentStudent", fields: [userId], references: [id], onDelete: Cascade)
  teacher User @relation("FreeStudentPaymentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
}

model Document {
  id         String @id @default(uuid())
  title      String
  fileUrl    String
  fileType   String
  size       Int
  visibility String @default("PUBLIC") // "PUBLIC", "CLASS", "PRIVATE"

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("TeacherDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListeningClip {
  id           String  @id @default(uuid())
  title        String
  script       String // exact TTS script, always shown to students as-is
  audioUrl     String
  accent       String  @default("US") // "UK", "US", "AUS" — set by teacher at upload time, used to filter practice clips
  level        String  @default("B1") // CEFR: "A1".."C1" — set by teacher at upload time
  status       String  @default("PROCESSING") // "PROCESSING", "READY", "FAILED"
  alignment    String? // JSON string: [{ "word": "...", "start": 0.0, "end": 0.0 }] from Whisper word timestamps
  errorMessage String?

  teacherId String
  teacher   User   @relation("TeacherListeningClips", fields: [teacherId], references: [id], onDelete: Cascade)

  // Exactly one of classroomId / studentId is set (enforced at the API level, not by the DB)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  studentId String?
  student   User?   @relation("StudentListeningClips", fields: [studentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpeakingTopic {
  id          String  @id @default(uuid())
  title       String
  description String? // shown to student before starting, e.g. "Đóng vai khách đặt phòng khách sạn"
  aiPersona   String // system prompt describing the AI's role/persona for this conversation
  openingLine String? // optional fixed first line; if empty, AI generates one from aiPersona

  teacherId String
  teacher   User   @relation("TeacherSpeakingTopics", fields: [teacherId], references: [id], onDelete: Cascade)

  // Exactly one of classroomId / studentId is set (enforced at the API level, not by the DB)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  studentId   String?
  student     User?      @relation("StudentSpeakingTopics", fields: [studentId], references: [id], onDelete: SetNull)

  sessions SpeakingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpeakingSession {
  id          String   @id @default(uuid())
  userId      String
  topicId     String? // null when the student self-created an ad-hoc context (not from the teacher's topic bank)
  contextText String? // student's own free-text context/scenario, used when topicId is null
  level       String? // CEFR level chosen for this session: "A1".."C1"
  purpose     String? // "IELTS" or "GENERAL" (giao tiếp)
  messages    String // JSON string: [{ role: "user"|"assistant", content: string }]
  status      String   @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED"
  feedback    String? // JSON string: { overall, fluency, vocabulary, grammar, clarity, suggestions[] } — coaching tone, no score
  practicedAt DateTime @default(now()) // when the session was completed/evaluated, shown on the exported PDF

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic SpeakingTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WritingSubmission {
  id          String   @id @default(uuid())
  userId      String
  prompt      String // the writing prompt/topic text shown to the student
  format      String   @default("ESSAY") // "PARAGRAPH", "EMAIL", "ESSAY"
  level       String   @default("B1") // CEFR: "A1".."C1"
  purpose     String   @default("GENERAL") // "IELTS" or "GENERAL" (giao tiếp)
  essay       String // student's submitted text
  feedback    String? // JSON string: { overall, grammar, vocabulary, organization, clarity, suggestions[] }
  practicedAt DateTime @default(now()) // when the student submitted for grading, shown on the exported PDF

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SavedWritingPrompt {
  id      String @id @default(uuid())
  userId  String
  prompt  String
  format  String @default("ESSAY")
  level   String @default("B1")
  purpose String @default("GENERAL")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ReadingAttempt {
  id          String   @id @default(uuid())
  userId      String
  topic       String?
  passage     String // the reading passage text
  level       String   @default("B1")
  purpose     String   @default("GENERAL")
  questions   String // JSON string: array of { type, prompt, options?, correctAnswer, explanation }
  answers     String // JSON string: student's answers keyed by question index
  score       Float // 0-10 auto-graded score
  analysis    String? // JSON string: AI per-question / per-question-type analysis, added after "Đánh giá"
  practicedAt DateTime @default(now()) // when the attempt was submitted, shown on the exported PDF

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ListeningExamAttempt {
  id          String   @id @default(uuid())
  userId      String
  clipId      String? // ListeningClip the exam was generated from, if any
  title       String   @default("Đề Luyện Nghe")
  level       String   @default("B1")
  purpose     String   @default("GENERAL")
  questions   String // JSON string: array of { type, prompt, options?, correctAnswer, explanation }
  answers     String // JSON string
  score       Float
  practicedAt DateTime @default(now()) // shown on the exported PDF

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Each row is one recorded-and-scored word/sentence attempt in Pronunciation Practice.
// Content is sourced from the student's own SRS vocab deck (VocabItem.phonetic/example),
// not teacher-authored — see VocabItem.addedByUserId for how classless students get words in.
model PronunciationAttempt {
  id          String   @id @default(uuid())
  userId      String
  vocabId     String? // VocabItem practiced, if sourced from the deck (may be deleted later, kept nullable)
  targetText  String
  transcript  String // Groq Whisper transcription of the student's recording
  matchScore  Float // 0-10, word-match ratio — an ASR-based proxy, not true phoneme scoring
  feedback    String? // JSON string: { overall, likelyIssues: [{word, tip}], suggestions: [] } from /coach
  practicedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// One attempt at an AI-generated mock test shaped like the real Vietnamese THPT Quốc Gia
// English exam (phonetics/stress, grammar & vocab, communication, cloze, reading comprehension
// — all sections share the ReadingQuestion shape from readingGrading.ts, tagged by `section`).
model MockTestAttempt {
  id           String    @id @default(uuid())
  userId       String
  variant      String    @default("SHORT") // "SHORT" (~20 câu/25 phút) or "FULL" (~40 câu/50 phút)
  sections     String // JSON string: [{ section, passage?, questions: ReadingQuestion[] }]
  answers      String // JSON string: answers keyed by flat question index
  score        Float // 0-10
  timeSpentSec Int?
  analysis     String? // JSON string, added after "Phân Tích Chi Tiết (AI)"
  practicedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// One row per completed practice attempt, used to feed the 4-skill radar chart on
// the student dashboard. "band" (exposed over the API as "score") is always a plain
// 0-10 estimate regardless of how the source practice tool scores itself internally —
// writing/conversation practice compute this silently (never shown to the student
// during practice) so the "no score, just coaching" experience there is unaffected.
model SkillPracticeResult {
  id     String @id @default(uuid())
  userId String
  skill  String // "READING", "LISTENING", "SPEAKING", "WRITING"
  band   Float // 0-10 (internal column name; API field is "score")
  source String // "READING_PRACTICE", "WRITING_PRACTICE", "SPEAKING_CONVERSATION", "LISTENING_SRS", "LISTENING_EXAM"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserVocabProgress {
  id      String @id @default(uuid())
  userId  String
  vocabId String

  status         String    @default("LEARNING")
  repetitions    Int       @default(0)
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate DateTime  @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab VocabItem @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
}

// ═══════════════════════════════════════════════════════════════════════════
// IELTS Cambridge module — teacher uploads a whole Cambridge book PDF (+ audio),
// AI extracts it into reusable IeltsTest records (Listening/Reading/Writing/Speaking),
// teacher reviews/edits before publishing, students take it (LIBRARY = self-practice
// any time, ASSIGNED = deadline + maxAttempts like Exam) and get graded: Listening/
// Reading against the book's own answer key (deterministic), Writing/Speaking against
// real IELTS band descriptors (AI). See CLAUDE.md for the full feature writeup.
// ═══════════════════════════════════════════════════════════════════════════

model IeltsBook {
  id    String @id @default(uuid())
  title String // e.g. "Cambridge IELTS 18"

  sourcePdfUrl String // Supabase URL of the originally uploaded book PDF (kept for teacher reference/re-extraction)
  rawText      String // full pdf-parse flat text — persisted so re-running extraction never re-parses the PDF
  pagesJson    String? // JSON string: [{num, text}] — per-page text from pdf-parse v2's getText(), powers page-anchored boundary detection

  boundariesJson  String? // Pass-1 AI output: {tests:[{testNumber,startPage,listening?,reading?,writing?,speaking?}], answerKey:{startPage,endPage}, audioscript:{startPage,endPage}}
  answerKeyText   String? // sliced (pure string-slice, no AI) from pagesJson using boundariesJson
  audioscriptText String? // same, for the Audioscript section

  extractionStatus String  @default("PENDING") // "PENDING" | "BOUNDARIES_EXTRACTED" | "EXTRACTING" | "EXTRACTED" | "FAILED"
  errorMessage     String?

  teacherId String
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tests     IeltsTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IeltsTest {
  id         String  @id @default(uuid())
  bookId     String
  testNumber Int // 1-4+ within the book
  title      String  @default("Test")
  testType   String? // "ACADEMIC" | "GENERAL_TRAINING" — AI proposes, teacher must confirm before publish (null until confirmed)

  status String @default("PENDING_EXTRACTION")
  // "PENDING_EXTRACTION" -> "EXTRACTED_DRAFT" (AI done, awaiting review) -> "NEEDS_ATTENTION"
  // (a skill's extraction failed / answer-key match incomplete) -> "REVIEWED" -> "PUBLISHED"

  // Delivery mode — configurable per test (not a global app setting). Exactly one group of
  // fields below is meaningful depending on deliveryMode, enforced at the API level (same
  // "exactly one, enforced at API level" convention as ListeningClip.classroomId/studentId).
  deliveryMode String @default("LIBRARY") // "LIBRARY" | "ASSIGNED"

  // LIBRARY mode: scoped like ListeningClip — visible to one classroom or one student, no deadline/limit.
  libraryClassroomId String?
  libraryClassroom   Classroom? @relation("IeltsTestLibraryClassroom", fields: [libraryClassroomId], references: [id], onDelete: SetNull)
  libraryStudentId   String?
  libraryStudent     User?      @relation("IeltsTestLibraryStudent", fields: [libraryStudentId], references: [id], onDelete: SetNull)

  // ASSIGNED mode: scoped like Exam — a classroom (bookkeeping) + explicit assigned students + deadline/maxAttempts.
  assignedClassroomId String?
  assignedClassroom   Classroom? @relation("IeltsTestAssignedClassroom", fields: [assignedClassroomId], references: [id], onDelete: SetNull)
  assignedStudents    User[]     @relation("IeltsTestAssignedStudents")
  publishTime         DateTime?
  deadline            DateTime?
  maxAttempts         Int        @default(1)

  book              IeltsBook               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  listeningSections IeltsListeningSection[]
  readingPassages   IeltsReadingPassage[]
  questions         IeltsQuestion[]
  writingTasks      IeltsWritingTask[]
  speakingParts     IeltsSpeakingPart[]

  listeningAttempts IeltsListeningAttempt[]
  readingAttempts   IeltsReadingAttempt[]
  writingAttempts   IeltsWritingAttempt[]
  speakingAttempts  IeltsSpeakingAttempt[]
  studySessions     IeltsStudySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, testNumber])
}

model IeltsListeningSection {
  id            String  @id @default(uuid())
  testId        String
  sectionNumber Int // 1-4
  instructions  String?
  audioUrl      String? // null until teacher manually tags it in review (not auto-detected from filename)

  test      IeltsTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions IeltsQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, sectionNumber])
}

model IeltsReadingPassage {
  id            String  @id @default(uuid())
  testId        String
  sectionNumber Int // which of the 3 Reading sections (Academic: 1 passage each; GT Section 1-2 may hold several short texts)
  passageIndex  Int     @default(1) // which sub-text within that section (GT Section 1-2 only, otherwise always 1)
  title         String?
  bodyText      String // extracted passage text — highest-risk field for multi-column reordering, always teacher-editable
  imageUrl      String? // optional accompanying diagram (e.g. a map/plan-labeling question's image) — manually attached

  test      IeltsTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions IeltsQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, sectionNumber, passageIndex])
}

// Shared question shape for Listening + Reading — mirrors frontend/src/lib/readingGrading.ts's
// ReadingQuestion (type/question/options/correctIndex/correctAnswer/wordLimit/explanation) so
// the same 10 IELTS-shaped question types and the same grading logic can be reused/ported.
model IeltsQuestion {
  id             String @id @default(uuid())
  testId         String // denormalized alongside the FK below purely so raw-score queries don't need a deep join
  skill          String // "LISTENING" | "READING"
  questionNumber Int // global 1-40 within (testId, skill) — matches the book's own numbering & the answer key

  listeningSectionId String?
  listeningSection   IeltsListeningSection? @relation(fields: [listeningSectionId], references: [id], onDelete: Cascade)
  readingPassageId   String?
  readingPassage     IeltsReadingPassage?   @relation(fields: [readingPassageId], references: [id], onDelete: Cascade)
  // Exactly one of listeningSectionId / readingPassageId is set, matching `skill` (same
  // "exactly one, enforced at API level" convention as ListeningClip.classroomId/studentId).

  type              String // one of readingGrading.ts's QuestionType values, reused as-is for BOTH skills
  groupInstruction  String? // shared instruction spanning several questions (e.g. "Questions 14-18: Complete the summary below")
  promptText        String
  options           String? // JSON string array — for MULTIPLE_CHOICE/MATCHING_* types
  correctIndex      Int?
  correctAnswer     String? // for FILL_TYPES (readingGrading.ts's FILL_TYPES)
  acceptableAnswers String? // JSON string array of alternate accepted spellings/forms (e.g. "colour"/"color")
  wordLimit         String? // e.g. "NO MORE THAN TWO WORDS"
  explanation       String?
  imageUrl          String? // for diagram/map/plan-labeling questions (modeled as MATCHING_FEATURES-style index selection against this image)

  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, skill, questionNumber])
}

model IeltsWritingTask {
  id          String  @id @default(uuid())
  testId      String
  taskNumber  Int // 1 | 2
  promptText  String
  imageUrl    String? // Academic Task 1's chart/graph/diagram — a real image the book contains; AI can't see it, teacher attaches manually in review. Null for GT Task 1 (a letter) and always for Task 2.
  minWords    Int     @default(150) // 150 for Task 1, 250 for Task 2 — structural IELTS convention, not a scoring number
  timeMinutes Int     @default(20) // 20 for Task 1, 40 for Task 2

  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, taskNumber])
}

model IeltsSpeakingPart {
  id           String  @id @default(uuid())
  testId       String
  partNumber   Int // 1 | 2 | 3
  instructions String?
  questions    String // JSON string array of prompt lines (Part 1/3: several short questions; Part 2: cue-card topic + bullet points)
  prepSeconds  Int? // 60 for Part 2's 1-minute prep; null for Part 1/3 (no fixed prep)
  speakSeconds Int? // 120 for Part 2's 2-minute talk; null for Part 1/3 (per-question, not fixed)

  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, partNumber])
}

// One row per attempt, FK'd to the reusable IeltsTest content (unlike MockTestAttempt/
// ReadingAttempt/WritingSubmission/SpeakingSession, which embed AI-generated content inline
// as JSON since it's fresh per attempt and never reused — many students take the *same*
// extracted Cambridge test over time, so the content itself must live independently of any
// one student's attempt).
model IeltsListeningAttempt {
  id            String   @id @default(uuid())
  userId        String
  testId        String
  answers       String // JSON: { [questionNumber]: number|string }
  rawScore      Int // 0-40
  band          Float // 0-9, .5 increments — via ieltsBandTables.js's LISTENING_BAND_TABLE
  timeSpentSec  Int?
  attemptNumber Int // 1st/2nd/... attempt by this user on this test, for maxAttempts enforcement in ASSIGNED mode
  practicedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model IeltsReadingAttempt {
  id            String   @id @default(uuid())
  userId        String
  testId        String
  answers       String
  rawScore      Int
  band          Float // via READING_BAND_TABLE_ACADEMIC or _GT, chosen by test.testType
  timeSpentSec  Int?
  attemptNumber Int
  practicedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model IeltsWritingAttempt {
  id            String   @id @default(uuid())
  userId        String
  testId        String
  task1Text     String
  task1Feedback String // JSON: {taskAchievement,coherenceCohesion,lexicalResource,grammaticalRangeAccuracy} each {band,comment}, + taskBand
  task2Text     String
  task2Feedback String // same shape (Task 2's first criterion is "Task Response", not "Task Achievement" — relabeled in the prompt only)
  overallBand   Float // (task1Band*1 + task2Band*2)/3, rounded per ieltsRounding.js
  attemptNumber Int
  practicedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model IeltsSpeakingAttempt {
  id     String @id @default(uuid())
  userId String
  testId String

  part1AudioUrl   String?
  part1Transcript String?
  part1Feedback   String? // JSON: {fluencyCoherence,lexicalResource,grammaticalRangeAccuracy,pronunciation} each {band,comment}, + overallBand
  part2AudioUrl   String?
  part2Transcript String?
  part2Feedback   String?
  part3AudioUrl   String?
  part3Transcript String?
  part3Feedback   String?

  overallBand   Float? // simple average of the 3 parts' overallBand — set once all 3 parts are submitted
  attemptNumber Int
  practicedAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// "Học đề" — the study step after a student finishes one skill of an IELTS test. One row per
// (skill, attempt): the AI's deep analysis of that attempt (why answers were wrong, vocabulary,
// structures, model answers) is generated once and cached here, plus any extra practice sets the
// student asked for on the questions/errors they got wrong. attemptId points at one of the 4
// Ielts*Attempt tables depending on `skill` (polymorphic, so no FK — same "enforced at API level"
// convention used elsewhere in the IELTS module).
model IeltsStudySession {
  id        String @id @default(uuid())
  userId    String
  testId    String
  skill     String // "LISTENING" | "READING" | "WRITING" | "SPEAKING"
  attemptId String

  analysis String? // JSON — shape depends on skill (see ieltsStudy.js)
  practice String? // JSON array of practice sets: [{ id, createdAt, title, passage?, script?, questions[], answers?, score?, total?, completedAt? }]

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test IeltsTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skill, attemptId])
  @@index([userId])
}

// ─── Blog ────────────────────────────────────────────────────────────────────
// Bài viết chia sẻ công khai tại /blog/[slug], giáo viên soạn ở /teacher/blog/editor.
// Bài chỉ hiện công khai khi status = PUBLISHED và publishedAt <= now (publishedAt ở tương lai = hẹn giờ đăng).
model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  posts       BlogPost[]
}

model BlogPost {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  excerpt         String?       // Tóm tắt ngắn — hiện ở thẻ danh sách, fallback cho meta description
  content         String        // HTML từ ReactQuill, đã sanitize ở backend khi lưu
  coverImage      String?       // URL ảnh bìa (Supabase Storage hoặc link ngoài)
  status          String        @default("DRAFT") // "DRAFT" | "PENDING" (chờ admin duyệt) | "PUBLISHED"
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  tags            String[]      @default([])
  readingMinutes  Int           @default(1)
  featured        Boolean       @default(false)
  views           Int           @default(0)
  // Bài liên quan do tác giả tự chọn (giữ đúng thứ tự). Không phải FK — bài bị xoá/gỡ đăng tự bị lọc khi đọc.
  relatedPostIds  String[]      @default([])

  authorId   String
  author     User          @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  revisions BlogPostRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

// Ảnh chụp phiên bản cũ của bài, tạo lúc lưu đè (tối đa BLOG_MAX_REVISIONS bản/bài)
model BlogPostRevision {
  id         String   @id @default(uuid())
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  title      String
  excerpt    String?
  content    String
  editedById String?
  editedBy   User?    @relation("BlogRevisionEditor", fields: [editedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}

